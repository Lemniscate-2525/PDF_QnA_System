# Copy this file to .env and fill in local values.
# Never commit your real .env or API keys.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=pdf_qna
DB_USER=postgres
DB_PASSWORD= 

OPENROUTER_API_KEY = your_openrouter_api_key_here
OPENROUTER_MODEL = nvidia/nemotron-3.5-super-vl:free

# OCR requires the Tesseract executable to be installed separately.
OCR_ENABLED=true
OCR_LANGUAGES=eng

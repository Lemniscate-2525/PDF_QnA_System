# Copy this file to .env and fill in local values.
# Never commit your real .env or API keys.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=pdf_qna
DB_USER=postgres
DB_PASSWORD= 

OPENROUTER_API_KEY = your_openrouter_api_key_here
OPENROUTER_MODEL = nvidia/nemotron-3.5-super-vl:free

# OCR requires the Tesseract executable to be installed separately.
OCR_ENABLED=true
OCR_LANGUAGES=eng

# Supabase Auth and private object storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
UPLOAD_BUCKET=pdf-uploads

# Shared Redis for distributed rate limiting, caching and RQ jobs
REDIS_URL=rediss://default:password@your-redis-host:6379
